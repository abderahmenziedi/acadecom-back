// ═══════════════════════════════════════════════════════════════
// AcadeCom — Prisma Schema v2.1 (Production-Ready)
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────

enum Role {
  participant
  brand
  quizmaster
  admin
}

enum Difficulty {
  easy
  medium
  hard
}

enum OrderStatus {
  pending
  confirmed
  delivered
  cancelled
}

enum NotificationType {
  badge_earned
  level_up
  quiz_completed
  quiz_played
  quiz_created
  quiz_deleted
  order_confirmed
  coupon_used
  reward_earned
  account_blocked
  account_unblocked
  system
}

enum ActivityAction {
  user_login
  user_register
  brand_block_quizmaster
  brand_unblock_quizmaster
  brand_delete_quizmaster
  brand_disable_quiz
  brand_enable_quiz
  brand_delete_quiz
  brand_update_profile
  quizmaster_create_quiz
  quizmaster_update_quiz
  quizmaster_delete_quiz
  participant_take_quiz
  participant_order
  admin_action
}

// ─── User ───────────────────────────────────────────────────────

model User {
  id            Int       @id @default(autoincrement())
  name          String?
  email         String    @unique
  password      String
  role          Role      @default(participant)
  isBlocked     Boolean   @default(false)
  avatar        String?   @db.VarChar(500)

  // Profile fields
  phone         String?   @db.VarChar(40)
  bio           String?   @db.Text
  address       String?   @db.VarChar(255)
  website       String?   @db.VarChar(255)
  socialLinks   String?   @db.Text  // JSON string of { facebook, twitter, instagram, linkedin }

  // Brand-specific
  brandId       Int?
  industry      String?   @db.VarChar(100)
  description   String?   @db.Text
  brand         User?     @relation("quizmasterToBrand", fields: [brandId], references: [id])
  quizmasters   User[]    @relation("quizmasterToBrand")

  // Gamification
  totalPoints   Int       @default(0)
  xp            Int       @default(0)
  level         Int       @default(1)
  coupons       Int       @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  // Relations
  quizzes         Quiz[]          @relation("quizmasterQuizzes")
  brandQuizzes    Quiz[]          @relation("brandQuizzes")
  attempts        Attempt[]       @relation("participantAttempts")
  answers         Answer[]        @relation("participantAnswers")
  pointsHistory   PointsHistory[] @relation("userPointsHistory")
  badges          UserBadge[]     @relation("userBadges")
  notifications   Notification[]  @relation("userNotifications")
  orders          Order[]         @relation("userOrders")
  products        Product[]       @relation("brandProducts")
  activitiesOwn   ActivityLog[]   @relation("activityActor")
  activitiesScope ActivityLog[]   @relation("activityScope")

  @@map("users")
}

// ─── Quiz Module ────────────────────────────────────────────────

model Quiz {
  id                Int        @id @default(autoincrement())
  title             String     @db.VarChar(255)
  description       String?    @db.Text
  brandId           Int
  quizmasterId      Int
  timeLimit         Int?
  pointsPerQuestion Int        @default(1)
  shuffleQuestions  Boolean    @default(false)
  isActive          Boolean    @default(false)
  difficulty        Difficulty @default(medium)
  maxAttempts       Int        @default(0)
  passingScore      Int        @default(50)
  xpReward          Int        @default(10)
  couponReward      Int        @default(0)
  category          String?    @db.VarChar(100)
  imageUrl          String?    @db.VarChar(500)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  quizmaster    User       @relation("quizmasterQuizzes", fields: [quizmasterId], references: [id], onDelete: Cascade)
  brand         User       @relation("brandQuizzes", fields: [brandId], references: [id], onDelete: Cascade)
  questions     Question[]
  attempts      Attempt[]

  @@index([quizmasterId])
  @@index([brandId])
  @@index([difficulty])
  @@index([category])
  @@map("quizzes")
}

model Question {
  id         Int        @id @default(autoincrement())
  quizId     Int
  text       String     @db.Text
  points     Int        @default(1)
  order      Int        @default(0)
  difficulty Difficulty @default(medium)
  hint       String?    @db.VarChar(500)
  createdAt  DateTime   @default(now())

  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options   Option[]
  answers   Answer[]

  @@index([quizId])
  @@map("questions")
}

model Option {
  id         Int      @id @default(autoincrement())
  questionId Int
  text       String   @db.VarChar(500)
  isCorrect  Boolean  @default(false)

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    Answer[]

  @@index([questionId])
  @@map("options")
}

model Attempt {
  id          Int       @id @default(autoincrement())
  quizId      Int
  userId      Int
  score       Int       @default(0)
  maxScore    Int       @default(0)
  completedAt DateTime?
  duration    Int?
  passed      Boolean   @default(false)
  xpEarned    Int       @default(0)
  couponsEarned Int     @default(0)
  createdAt   DateTime  @default(now())

  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user      User     @relation("participantAttempts", fields: [userId], references: [id], onDelete: Cascade)
  answers   Answer[]

  @@index([quizId])
  @@index([userId])
  @@index([completedAt])
  @@map("attempts")
}

model Answer {
  id         Int      @id @default(autoincrement())
  attemptId  Int
  questionId Int
  optionId   Int
  userId     Int?
  isCorrect  Boolean  @default(false)
  createdAt  DateTime @default(now())

  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option     Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user       User?    @relation("participantAnswers", fields: [userId], references: [id])

  @@index([attemptId])
  @@index([questionId])
  @@map("answers")
}

// ─── Gamification ───────────────────────────────────────────────

model PointsHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  points    Int
  reason    String   @db.VarChar(255)
  attemptId Int?
  createdAt DateTime @default(now())

  user      User     @relation("userPointsHistory", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("points_history")
}

model Badge {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  description String   @db.VarChar(500)
  icon        String   @db.VarChar(100)
  condition   String   @db.VarChar(255)
  xpReward    Int      @default(0)
  createdAt   DateTime @default(now())

  users       UserBadge[] @relation("badgeUsers")

  @@map("badges")
}

model UserBadge {
  id        Int      @id @default(autoincrement())
  userId    Int
  badgeId   Int
  earnedAt  DateTime @default(now())

  user      User     @relation("userBadges", fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation("badgeUsers", fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// ─── Marketplace / Store ────────────────────────────────────────

model Product {
  id          Int      @id @default(autoincrement())
  brandId     Int
  title       String   @db.VarChar(255)
  description String?  @db.Text
  price       Int
  stock       Int      @default(0)
  imageUrl    String?  @db.VarChar(500)
  isActive    Boolean  @default(true)
  category    String?  @db.VarChar(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand       User     @relation("brandProducts", fields: [brandId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  @@index([brandId])
  @@map("products")
}

model Order {
  id          Int         @id @default(autoincrement())
  userId      Int
  totalPrice  Int
  status      OrderStatus @default(pending)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation("userOrders", fields: [userId], references: [id], onDelete: Cascade)
  items       OrderItem[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id        Int   @id @default(autoincrement())
  orderId   Int
  productId Int?
  quantity  Int   @default(1)
  price     Int

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

// ─── Notifications ──────────────────────────────────────────────

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String           @db.VarChar(255)
  message   String           @db.Text
  link      String?          @db.VarChar(500)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation("userNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ─── Activity / Audit Log ───────────────────────────────────────

model ActivityLog {
  id         Int            @id @default(autoincrement())
  actorId    Int                                  // who performed the action
  scopeId    Int?                                 // resource owner (brand id, target user, etc.)
  action     ActivityAction
  entityType String?        @db.VarChar(50)       // e.g. "quiz", "user", "order"
  entityId   Int?
  metadata   String?        @db.Text              // JSON string
  createdAt  DateTime       @default(now())

  actor      User           @relation("activityActor", fields: [actorId], references: [id], onDelete: Cascade)
  scope      User?          @relation("activityScope", fields: [scopeId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([scopeId])
  @@index([action])
  @@map("activity_logs")
}
