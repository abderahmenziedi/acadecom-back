generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String
  avatar    String?
  role      Role      @default(participant)
  isBlocked Boolean   @default(false)
  createdAt DateTime  @default(now())

  admin         Admin?
  brand         Brand?
  quizmaster    Quizmaster?
  participant   Participant?
  notifications Notification[]
}

enum Role {
  admin
  brand
  quizmaster
  participant
}

enum QuizmasterApprovalStatus {
  PENDING
  ACTIVE
  REJECTED
}

model Admin {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum BrandPlanType {
  FREE
  PRO
  PRO_PLUS
}

enum BrandSubscriptionStatus {
  ACTIVE
  PENDING_PAYMENT
  EXPIRED
}

/** Cycle payant ou historique (upgrade / downgrade / renouvellement). */
enum BillingCycleLifecycle {
  ACTIVE
  EXPIRED
  SUPERSEDED
}

model Brand {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique
  industry    String?
  description String?
  logoUrl     String?
  planType              BrandPlanType           @default(FREE)
  subscriptionStatus    BrandSubscriptionStatus  @default(ACTIVE)
  stripeCustomerId      String?

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  quizmasters Quizmaster[]
  quizzes     Quiz[]
  products    Product[]
  subscriptions BrandSubscriptionCycle[]
}

/** Historique et cycle courant pour les packs PRO / PRO_PLUS (paiement Stripe ou mode démo). */
model BrandSubscriptionCycle {
  id                Int                     @id @default(autoincrement())
  brandId           Int
  planType          BrandPlanType
  lifecycle         BillingCycleLifecycle   @default(ACTIVE)
  paymentDate       DateTime
  startDate         DateTime
  endDate           DateTime
  amountMinor       Int                     @default(0)
  currency          String                  @default("tnd")

  stripeCheckoutSessionId String?             @unique
  stripePaymentIntentId   String?
  expiryWarnedAt          DateTime?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([brandId, lifecycle])
  @@map("brand_subscriptions")
}

model Quizmaster {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique
  brandId          Int
  approvalStatus   QuizmasterApprovalStatus @default(PENDING)
  phoneE164        String?
  gender           String?
  birthDate        DateTime? @db.Date
  profilePhotoUrl  String?
  isProfileComplete Boolean  @default(false)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand            Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  quizzes Quiz[]

  @@index([brandId, approvalStatus])
}

model Participant {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique
  xp               Int       @default(0)
  coupons          Int       @default(0)
  totalPoints      Int       @default(0)
  xpRankId         Int       @default(1)
  phoneE164        String?
  gender             String?
  birthDate          DateTime? @db.Date
  country            String?
  city               String?
  profilePhotoUrl    String?
  isProfileComplete  Boolean   @default(false)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  xpRank             XpRank    @relation(fields: [xpRankId], references: [id])

  sessions     GameSession[]
  orders       Order[]
  preAnswers   PreAnswer[]
  quizAttempts ParticipantQuizAttempt[]
}

model XpRank {
  id     Int    @id @default(autoincrement())
  label  String
  minXp  Int
  maxXp  Int
  icon   String

  participants Participant[]
}

model Quiz {
  id               Int @id @default(autoincrement())
  brandId          Int
  quizmasterId     Int
  title            String
  category         String?
  image            String?
  maxCoupons       Int     @default(10)
  isActive         Boolean @default(false)
  durationSeconds  Int     @default(300)
  passingScore     Float   @default(0.5)
  randomizeQuestions Boolean @default(false)
  shuffleOptions     Boolean @default(false)
  hasPreQuestions    Boolean   @default(false)
  createdAt        DateTime @default(now())

  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  quizmaster    Quizmaster    @relation(fields: [quizmasterId], references: [id], onDelete: Cascade)
  questions     Question[]
  preQuestions  PreQuestion[]
  sessions      GameSession[]
  quizAttempts  ParticipantQuizAttempt[]
}

/** Une entrée = le participant a engagé sa tentative unique (dès le clic « Jouer » / début du flux). */
model ParticipantQuizAttempt {
  id            Int      @id @default(autoincrement())
  participantId Int
  quizId        Int
  createdAt     DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  quiz        Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([participantId, quizId])
  @@index([quizId])
}

model PreQuestion {
  id           Int    @id @default(autoincrement())
  quizId       Int
  questionText String @db.Text
  sortOrder    Int    @default(0)
  quiz         Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers      PreAnswer[]

  @@index([quizId])
}

model PreAnswer {
  id             Int      @id @default(autoincrement())
  preQuestionId  Int
  participantId  Int
  answerText     String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  preQuestion PreQuestion @relation(fields: [preQuestionId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([preQuestionId, participantId])
}

model Question {
  id         Int     @id @default(autoincrement())
  quizId     Int
  text       String  @db.Text
  xpReward   Int     @default(10)
  hint       String?

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options Option[]
  answers Answer[]
}

model Option {
  id         Int    @id @default(autoincrement())
  questionId Int
  text       String @db.VarChar(500)
  isCorrect  Boolean @default(false)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model GameSession {
  id              Int @id @default(autoincrement())
  participantId   Int
  quizId          Int
  scorePercent    Float   @default(0)
  xpEarned        Int     @default(0)
  couponsEarned   Int     @default(0)
  passed          Boolean @default(false)
  durationSeconds Int     @default(0)
  playedAt        DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  quiz        Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers     Answer[]

  @@unique([participantId, quizId])
}

model Answer {
  id                Int @id @default(autoincrement())
  sessionId         Int
  questionId        Int
  selectedOptionIds Json
  isCorrect         Boolean @default(false)

  session  GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Product {
  id          Int     @id @default(autoincrement())
  brandId     Int
  name        String
  description String? @db.Text
  couponPrice Int
  stock       Int     @default(0)
  image       String?
  isActive    Boolean @default(true)

  brand      Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
}

model Order {
  id            Int @id @default(autoincrement())
  participantId Int
  totalCoupons  Int
  status        OrderStatus @default(pending)
  createdAt     DateTime    @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  items       OrderItem[]
}

enum OrderStatus {
  pending
  confirmed
  delivered
  cancelled
}

model OrderItem {
  id               Int @id @default(autoincrement())
  orderId          Int
  productId        Int
  quantity         Int @default(1)
  unitCouponPrice  Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
