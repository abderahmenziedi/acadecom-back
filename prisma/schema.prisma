// ═══════════════════════════════════════════════════════════════
// AcadeCom — Prisma Schema v2.0 (Production-Ready)
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────

enum Role {
  participant
  brand
  quizmaster
  admin
}

enum Difficulty {
  easy
  medium
  hard
}

enum OrderStatus {
  pending
  confirmed
  delivered
  cancelled
}

enum NotificationType {
  badge_earned
  level_up
  quiz_completed
  order_confirmed
  reward_earned
  system
}

// ─── User ───────────────────────────────────────────────────────

model User {
  id            Int       @id @default(autoincrement())
  name          String?
  email         String    @unique
  password      String
  role          Role      @default(participant)
  isBlocked     Boolean   @default(false)
  avatar        String?   @db.VarChar(500)

  // Brand fields
  brandId       Int?
  industry      String?   @db.VarChar(100)
  description   String?   @db.Text
  brand         User?     @relation("quizmasterToBrand", fields: [brandId], references: [id])
  quizmasters   User[]    @relation("quizmasterToBrand")

  // Gamification
  totalPoints   Int       @default(0)
  xp            Int       @default(0)
  level         Int       @default(1)
  coupons       Int       @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  // Relations
  quizzes         Quiz[]          @relation("quizmasterQuizzes")
  attempts        Attempt[]       @relation("participantAttempts")
  answers         Answer[]        @relation("participantAnswers")
  pointsHistory   PointsHistory[] @relation("userPointsHistory")
  badges          UserBadge[]     @relation("userBadges")
  notifications   Notification[]  @relation("userNotifications")
  orders          Order[]         @relation("userOrders")
  products        Product[]       @relation("brandProducts")

  @@map("users")
}

// ─── Quiz Module ────────────────────────────────────────────────

model Quiz {
  id                Int        @id @default(autoincrement())
  title             String     @db.VarChar(255)
  description       String?    @db.Text
  brandId           Int
  quizmasterId      Int
  timeLimit         Int?
  pointsPerQuestion Int        @default(1)
  shuffleQuestions  Boolean    @default(false)
  isActive          Boolean    @default(false)
  difficulty        Difficulty @default(medium)
  maxAttempts       Int        @default(0)        // 0 = illimité
  passingScore      Int        @default(50)       // % minimum pour réussir
  xpReward          Int        @default(10)       // XP gagnés à la complétion
  couponReward      Int        @default(0)        // Coupons gagnés si réussi
  category          String?    @db.VarChar(100)
  imageUrl          String?    @db.VarChar(500)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  quizmaster    User       @relation("quizmasterQuizzes", fields: [quizmasterId], references: [id])
  questions     Question[]
  attempts      Attempt[]

  @@index([quizmasterId])
  @@index([brandId])
  @@index([difficulty])
  @@index([category])
  @@map("quizzes")
}

model Question {
  id         Int        @id @default(autoincrement())
  quizId     Int
  text       String     @db.Text
  points     Int        @default(1)
  order      Int        @default(0)
  difficulty Difficulty @default(medium)
  hint       String?    @db.VarChar(500)
  createdAt  DateTime   @default(now())

  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options   Option[]
  answers   Answer[]

  @@index([quizId])
  @@map("questions")
}

model Option {
  id         Int      @id @default(autoincrement())
  questionId Int
  text       String   @db.VarChar(500)
  isCorrect  Boolean  @default(false)

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    Answer[]

  @@index([questionId])
  @@map("options")
}

model Attempt {
  id          Int       @id @default(autoincrement())
  quizId      Int
  userId      Int
  score       Int       @default(0)
  maxScore    Int       @default(0)
  completedAt DateTime?
  duration    Int?
  passed      Boolean   @default(false)
  xpEarned    Int       @default(0)
  couponsEarned Int     @default(0)
  createdAt   DateTime  @default(now())

  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user      User     @relation("participantAttempts", fields: [userId], references: [id])
  answers   Answer[]

  @@index([quizId])
  @@index([userId])
  @@index([completedAt])
  @@map("attempts")
}

model Answer {
  id         Int      @id @default(autoincrement())
  attemptId  Int
  questionId Int
  optionId   Int
  isCorrect  Boolean  @default(false)
  createdAt  DateTime @default(now())

  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option     Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user       User?    @relation("participantAnswers", fields: [userId], references: [id])
  userId     Int?

  @@index([attemptId])
  @@index([questionId])
  @@map("answers")
}

// ─── Gamification ───────────────────────────────────────────────

model PointsHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  points    Int
  reason    String   @db.VarChar(255)
  attemptId Int?
  createdAt DateTime @default(now())

  user      User     @relation("userPointsHistory", fields: [userId], references: [id])

  @@index([userId])
  @@map("points_history")
}

model Badge {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  description String   @db.VarChar(500)
  icon        String   @db.VarChar(100)     // emoji ou icon name
  condition   String   @db.VarChar(255)     // ex: "quizzes_completed:5"
  xpReward    Int      @default(0)
  createdAt   DateTime @default(now())

  users       UserBadge[] @relation("badgeUsers")

  @@map("badges")
}

model UserBadge {
  id        Int      @id @default(autoincrement())
  userId    Int
  badgeId   Int
  earnedAt  DateTime @default(now())

  user      User     @relation("userBadges", fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation("badgeUsers", fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// ─── Marketplace / Store ────────────────────────────────────────

model Product {
  id          Int      @id @default(autoincrement())
  brandId     Int
  title       String   @db.VarChar(255)
  description String?  @db.Text
  price       Int                            // Prix en coupons
  stock       Int      @default(0)
  imageUrl    String?  @db.VarChar(500)
  isActive    Boolean  @default(true)
  category    String?  @db.VarChar(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand       User     @relation("brandProducts", fields: [brandId], references: [id])
  orderItems  OrderItem[]

  @@index([brandId])
  @@map("products")
}

model Order {
  id          Int         @id @default(autoincrement())
  userId      Int
  totalPrice  Int                            // Total en coupons
  status      OrderStatus @default(pending)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation("userOrders", fields: [userId], references: [id])
  items       OrderItem[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id        Int   @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int   @default(1)
  price     Int                              // Prix unitaire au moment de l'achat

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ─── Notifications ──────────────────────────────────────────────

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String           @db.VarChar(255)
  message   String           @db.Text
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation("userNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}