generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String
  avatar    String?
  role      Role      @default(participant)
  isBlocked Boolean   @default(false)
  createdAt DateTime  @default(now())

  admin         Admin?
  brand         Brand?
  quizmaster    Quizmaster?
  participant   Participant?
  notifications Notification[]
}

enum Role {
  admin
  brand
  quizmaster
  participant
}

enum QuizmasterApprovalStatus {
  PENDING
  ACTIVE
  REJECTED
}

model Admin {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum BrandPlanType {
  FREE
  PRO
  PRO_PLUS
}

enum BrandSubscriptionStatus {
  ACTIVE
  PENDING_PAYMENT
  EXPIRED
}

/** Cycle payant ou historique (upgrade / downgrade / renouvellement). */
enum BillingCycleLifecycle {
  ACTIVE
  EXPIRED
  SUPERSEDED
}

model Brand {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique
  industry    String?
  description String?
  logoUrl     String?
  planType              BrandPlanType           @default(FREE)
  subscriptionStatus    BrandSubscriptionStatus  @default(ACTIVE)
  stripeCustomerId      String?

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  quizmasters Quizmaster[]
  quizzes     Quiz[]
  products    Product[]
  subscriptions BrandSubscriptionCycle[]
}

/** Historique et cycle courant pour les packs PRO / PRO_PLUS (paiement Stripe ou mode démo). */
model BrandSubscriptionCycle {
  id                Int                     @id @default(autoincrement())
  brandId           Int
  planType          BrandPlanType
  lifecycle         BillingCycleLifecycle   @default(ACTIVE)
  paymentDate       DateTime
  startDate         DateTime
  endDate           DateTime
  amountMinor       Int                     @default(0)
  currency          String                  @default("tnd")

  stripeCheckoutSessionId String?             @unique
  stripePaymentIntentId   String?
  expiryWarnedAt          DateTime?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([brandId, lifecycle])
  @@map("brand_subscriptions")
}

model Quizmaster {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique
  brandId          Int
  approvalStatus   QuizmasterApprovalStatus @default(PENDING)
  phoneE164        String?
  gender           String?
  birthDate        DateTime? @db.Date
  profilePhotoUrl  String?
  isProfileComplete Boolean  @default(false)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand            Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  quizzes Quiz[]

  @@index([brandId, approvalStatus])
}

model Participant {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique
  xp               Int       @default(0)
  coupons          Int       @default(0)
  totalPoints      Int       @default(0)
  xpRankId         Int       @default(1)
  phoneE164        String?
  gender             String?
  birthDate          DateTime? @db.Date
  country            String?
  city               String?
  profilePhotoUrl    String?
  isProfileComplete  Boolean   @default(false)
  /** Pré-réponses [{ quizId, preQuestionId, answerText }] */
  preAnswersJson     Json      @default("[]")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  xpRank             XpRank    @relation(fields: [xpRankId], references: [id])

  orders       Order[]
  quizAttempts QuizAttempt[]
}

model XpRank {
  id     Int    @id @default(autoincrement())
  label  String
  minXp  Int
  maxXp  Int
  icon   String

  participants Participant[]
}

model Quiz {
  id               Int @id @default(autoincrement())
  brandId          Int
  quizmasterId     Int
  title            String
  category         String?
  image            String?
  maxCoupons       Int     @default(10)
  isActive         Boolean @default(false)
  durationSeconds  Int     @default(300)
  passingScore     Float   @default(0.5)
  randomizeQuestions Boolean @default(false)
  shuffleOptions     Boolean @default(false)
  hasPreQuestions    Boolean   @default(false)
  createdAt        DateTime @default(now())

  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  quizmaster    Quizmaster    @relation(fields: [quizmasterId], references: [id], onDelete: Cascade)
  questions     Question[]
  preQuestions  PreQuestion[]
  quizAttempts  QuizAttempt[]
}

/** Réservation + session de jeu (remplace ParticipantQuizAttempt + GameSession + Answer). */
model QuizAttempt {
  id              Int       @id @default(autoincrement())
  participantId   Int
  quizId          Int
  reservedAt      DateTime  @default(now())
  /** null = démarré, pas encore joué */
  completedAt     DateTime?
  scorePercent    Float     @default(0)
  xpEarned        Int       @default(0)
  couponsEarned   Int       @default(0)
  passed          Boolean   @default(false)
  durationSeconds Int       @default(0)
  /** [{ questionId, selectedOptionIds, isCorrect }] */
  responses       Json?

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  quiz        Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([participantId, quizId])
  @@index([quizId])
}

model PreQuestion {
  id           Int    @id @default(autoincrement())
  quizId       Int
  questionText String @db.Text
  sortOrder    Int    @default(0)
  quiz         Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model Question {
  id       Int     @id @default(autoincrement())
  quizId   Int
  text     String  @db.Text
  xpReward Int     @default(10)
  hint     String?
  /** [{ id, text, isCorrect }] */
  options  Json

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model Product {
  id          Int     @id @default(autoincrement())
  brandId     Int
  name        String
  description String? @db.Text
  couponPrice Int
  stock       Int     @default(0)
  image       String?
  isActive    Boolean @default(true)

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

model Order {
  id            Int @id @default(autoincrement())
  participantId Int
  totalCoupons  Int
  status        OrderStatus @default(pending)
  createdAt     DateTime    @default(now())
  /** [{ productId, quantity, unitCouponPrice }] */
  items         Json        @default("[]")

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

enum OrderStatus {
  pending
  confirmed
  delivered
  cancelled
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
