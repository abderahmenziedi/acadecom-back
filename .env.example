# ───────────────────────────────────────────────────────────────────────────
# AcadeCom Backend — Environment variables (template).
# Copy to `.env` and fill in real values. Never commit the real `.env`.
# ───────────────────────────────────────────────────────────────────────────

# ─── Required ──────────────────────────────────────────────────────────────

# Prisma connection string (MySQL 8+)
DATABASE_URL="mysql://acadecom:strong-password@localhost:3306/acadecom"

# JWT signing key — ≥ 32 characters in production. Generate one via:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="REPLACE_ME_WITH_A_LONG_RANDOM_STRING"

# Allowed frontend origin(s). Comma-separated for multiple (staging + prod).
CLIENT_URL="http://localhost:5173"

# development | production | test
NODE_ENV="development"

# ─── Optional (sensible defaults applied at boot) ──────────────────────────

PORT=3000
LOG_LEVEL=info

# Access token lifetime (vercel/ms format).
ACCESS_TOKEN_TTL=4h

# Refresh token lifetime — reserved for the Phase 2b refresh-token rollout.
REFRESH_TOKEN_TTL=7d

# Rate limit on /auth/login & /auth/register (per IP).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5
