DATABASE_URL="mysql://user:password@localhost:3306/acadecom"
TEST_DATABASE_URL="mysql://user:password@localhost:3306/acadecom_test"
JWT_SECRET="please-use-at-least-32-characters-secret"
CLIENT_URL="http://localhost:5173"
PORT=3000

# Stripe (packs Pro / Pro Plus — paiement unique)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Créez deux produits/prix dans le Stripe Dashboard (ex. 20 TND et 60 TND) et collez les price_…
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PRO_PLUS=

# Démo locale sans Stripe : true uniquement si NODE_ENV ≠ production — applique Pro/Pro Plus sans paiement.
BILLING_DEV_MODE=false

# Durée (jours) d’un cycle payé après paiement Stripe ou démo réussi.
SUBSCRIPTION_PACK_DAYS=30

# Minor units affichées en dev sans Stripe — alignez sur vos montants Stripe.
DEV_PRICE_PRO_MINOR=200000
DEV_PRICE_PRO_PLUS_MINOR=600000

